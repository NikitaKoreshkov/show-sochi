# Скопируйте в .env и заполните. Публичное демо на Vercel работает без БД:
# все чтения из Settings падают в захардкоженный контент, поэтому DATABASE_URL
# можно оставить пустым. Запись (бронирование, логин админа) потребует БД.

# PostgreSQL (Prisma). Пусто = демо в режиме чтения.
DATABASE_URL=

# NextAuth v4. Обязателен для /admin (без него middleware не сможет проверить сессию).
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Первый администратор, создаётся скриптом db:seed.
ADMIN_EMAIL=
ADMIN_PASSWORD=
SUPERADMIN_EMAIL=

# Видео в первом экране. По умолчанию /video/drone.mp4 из репозитория.
NEXT_PUBLIC_HERO_VIDEO_URL=
NEXT_PUBLIC_HERO_POSTER_URL=
NEXT_PUBLIC_HERO_VERSION=

# Метрика и GA4 включаются только когда заданы ID, иначе модули не рендерятся.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_YANDEX_METRIKA_ID=
