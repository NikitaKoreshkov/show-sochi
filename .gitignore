# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# runtime uploads (keep folder, ignore contents)
public/uploads/*
!public/uploads/.gitkeep
# curated gallery so the demo shows real photos without the client DB
!public/uploads/demo/
!public/uploads/demo/*

# large sample videos (keep folder)
public/video/*
!public/video/.gitkeep
# bundled hero reel so the demo renders without the admin-uploaded video
!public/video/drone.mp4
!public/video/drone-poster.jpg
